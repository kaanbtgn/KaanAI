@KaanAI.API_HostAddress = https://localhost:7001

### Create a new chat session
POST {{KaanAI.API_HostAddress}}/api/chat/sessions
Content-Type: application/json

{
  "createdBy": "testuser@example.com"
}

### Get a specific chat session
GET {{KaanAI.API_HostAddress}}/api/chat/sessions/1

### Get all sessions for a user
GET {{KaanAI.API_HostAddress}}/api/chat/sessions/user/testuser@example.com

### Add a question to a session
POST {{KaanAI.API_HostAddress}}/api/chat/questions
Content-Type: application/json

{
  "sessionId": 1,
  "content": "What is the capital of France?"
}

### Add an answer to a session
POST {{KaanAI.API_HostAddress}}/api/chat/answers
Content-Type: application/json

{
  "sessionId": 1,
  "answerText": "The capital of France is Paris."
}

### Create a session using SessionController
POST {{KaanAI.API_HostAddress}}/api/session
Content-Type: application/json

{
  "createdBy": "anotheruser@example.com"
}
